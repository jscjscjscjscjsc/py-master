# ============================================================
# PyMaster 配置文件示例
# 复制成 .env 后填写即可；也可以不做任何事——
# 首次打开程序会自动进入网页配置向导（/setup），在那里填更好用。
# ============================================================

# ── 大模型配置（必填）──────────────────────────────────────
# 任何 OpenAI 兼容接口都可以。填到 /v1 或 /v3 为止，不用带后面的路径。
PYMASTER_AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
PYMASTER_AI_MODEL=doubao-seed-2-0-code-preview-260215
ARK_API_KEY=
# 主模型额度用尽时自动切换的备用模型，多个用英文逗号分隔
PYMASTER_AI_FALLBACK_MODELS=doubao-seed-2-0-lite-260215,doubao-seed-2-0-pro-260215

# 其他服务商示例：
#   DeepSeek     PYMASTER_AI_BASE_URL=https://api.deepseek.com/v1
#                PYMASTER_AI_MODEL=deepseek-chat
#   硅基流动      PYMASTER_AI_BASE_URL=https://api.siliconflow.cn/v1
#                PYMASTER_AI_MODEL=Qwen/Qwen2.5-7B-Instruct
#   通义千问      PYMASTER_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                PYMASTER_AI_MODEL=qwen-plus
#   本地 Ollama   PYMASTER_AI_BASE_URL=http://localhost:11434/v1
#                PYMASTER_AI_MODEL=qwen2.5:7b
#                ARK_API_KEY=ollama

# ── 微信扫码登录（选填）────────────────────────────────────
# 微信扫码全程由微信服务器回调，回调地址必须是已备案的公网域名，
# 所以只在自己电脑上跑（127.0.0.1）是打不通的——默认关闭。
# 需要去「微信开放平台 → 网站应用」申请，审核通过后填下面三项并重启即可启用。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 公网可访问的地址，例如 https://pymaster.yourdomain.com
OAUTH_CALLBACK_BASE=

# ── 豆包 TTS（选填，已默认使用免费的 edge-tts）─────────────
DOUBAO_TTS_APP_ID=
DOUBAO_ACCESS_TOKEN=
DOUBAO_SECRET_KEY=
